# Choose an available tool-capable model in your provider account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional compatible provider endpoint; keep empty for OpenAI.
OPENAI_BASE_URL=
ASSISTANT_NAME=Mel
DATABASE_PATH=data/processed/store.sqlite
APP_ENV=local
# Safe default. Set false only for an intentional live deployment.
META_DRY_RUN=true
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Your randomly generated webhook handshake token (NOT an access token).
META_VERIFY_TOKEN=
# Meta App secret, used for HMAC of raw incoming bodies.
META_APP_SECRET=
# Explicitly choose a currently supported version in your Meta dashboard.
META_GRAPH_API_VERSION=
# Live notebook tests are always opt-in; never auto-enabled.
RUN_LIVE_LLM=false
RUN_LIVE_META=false
LIVE_META_RECIPIENT=
LIVE_META_TEMPLATE_NAME=
LIVE_META_TEMPLATE_LANGUAGE=pt_BR
LIVE_META_TEMPLATE_APPROVED=false
